# Server
NODE_ENV=development
PORT=3000
# Number of reverse proxies in front of the app (1 when behind Caddy/nginx, else 0)
TRUST_PROXY=0
# Web build only. Native apps are not subject to CORS. Comma-separated.
CORS_ORIGINS=http://localhost:19006

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/textsy

# Auth. In production JWT_SECRET is required and must be 32+ random characters,
# e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Closed beta: comma-separated codes. Leave empty to allow open signup.
INVITE_CODES=
# Cities users may pick (comma-separated). The first one is the default.
CITIES=Meerut

# Temporary, until intro requests exist: lets users open a chat by handle.
# Defaults to true outside production and false in production.
ALLOW_DIRECT_CHAT_CREATION=true

# Rate limits (window in ms). Limits are per signed-in user, not per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_USER_MAX=600
RATE_LIMIT_AUTH_MAX=20
